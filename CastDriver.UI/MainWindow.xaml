<Window x:Class="CastDriver.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CastDriver.UI.ViewModels"
        Title="Cast Sound"
        Icon="icon.ico"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Bool → Visibility -->
            <BooleanToVisibilityConverter x:Key="BoolVis"/>

            <!-- Invert bool → Visibility -->
            <Style x:Key="HideWhenTrue" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCasting}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer border gives rounded corners + shadow -->
    <Border Background="{StaticResource BgBrush}"
            CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4"
                              Color="Black" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel>

            <!-- ── Title bar ──────────────────────────────────────── -->
            <Border Background="Transparent"
                    CornerRadius="14 14 0 0"
                    MouseLeftButtonDown="OnTitleBarDrag"
                    Cursor="SizeAll"
                    Padding="16,12,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cast icon (path geometry) -->
                    <Canvas Width="20" Height="20" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <!-- Screen base -->
                        <Rectangle Canvas.Left="2" Canvas.Top="12"
                                   Width="16" Height="8"
                                   Fill="Transparent"
                                   Stroke="{StaticResource AccentBrush}"
                                   StrokeThickness="1.5"
                                   RadiusX="1" RadiusY="1"/>
                        <!-- Arc 1 (small) -->
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 2,15 A 4,4 0 0 1 5,12"/>
                        <!-- Arc 2 (medium) -->
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 2,18 A 8,8 0 0 1 9,12"/>
                        <!-- Arc 3 (large) -->
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 2,20 A 12,12 0 0 1 13,12"/>
                        <!-- Dot (connected corner) -->
                        <Ellipse Canvas.Left="2" Canvas.Top="18"
                                 Width="4" Height="4"
                                 Fill="{StaticResource AccentBrush}"/>
                    </Canvas>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cast Sound"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CaptureDeviceName}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="OnTogglePin" ToolTip="Pin (keep open)"
                                Opacity="0.5"
                                Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock Text="📌" FontSize="12"/>
                        </Button>
                        <Button x:Name="MinButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="OnMinimize" ToolTip="Minimize"
                                Visibility="Collapsed"
                                Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock Text="—" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="OnClose" ToolTip="Hide"
                                Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Driver warning banner -->
            <Border Background="#3300A8FF"
                    BorderBrush="#220A84FF" BorderThickness="0 1 0 1"
                    Padding="16,10"
                    Visibility="{Binding IsDriverInstalled, Converter={StaticResource BoolVis},
                                         ConverterParameter=Inverse}">
                <!-- BoolVis doesn't invert — use a trigger instead -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scream audio driver not installed."
                               Foreground="White" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1"
                            Content="Install"
                            Command="{Binding InstallDriverCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="12" Padding="10,4"/>
                </Grid>
            </Border>

            <!-- Update-available banner -->
            <Border Background="#3330D158"
                    BorderBrush="#2230D158" BorderThickness="0 1 0 1"
                    Padding="16,10"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UpdateText}"
                               Foreground="White" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1"
                            Content="Download"
                            Command="{Binding OpenUpdateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="12" Padding="10,4"/>
                </Grid>
            </Border>

            <!-- ── Source section ────────────────────────────────── -->
            <StackPanel Margin="16,12,16,0">
                <TextBlock Text="SOURCE" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                <ComboBox Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding SourcesView}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName">
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="8,6,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                </ComboBox>

                <!-- Exclude-app option: cast everything EXCEPT the chosen app -->
                <CheckBox Content="Cast everything except this app"
                          IsChecked="{Binding ExcludeApp, Mode=TwoWay}"
                          FontSize="12" Margin="2,8,0,0"
                          Visibility="{Binding IsAppSelected, Converter={StaticResource BoolVis}}"/>

                <TextBlock Text="FORMAT" Style="{StaticResource LabelStyle}" Margin="0,10,0,6"/>
                <ComboBox Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding CodecOptions}"
                          SelectedItem="{Binding SelectedCodec, Mode=TwoWay}"/>

                <!-- MP3 bitrate (only relevant for MP3) -->
                <Grid Margin="0,8,0,0"
                      Visibility="{Binding IsMp3, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bitrate" Style="{StaticResource SmallStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Bitrates}"
                              SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}"/>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Latency" Style="{StaticResource SmallStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Grid.Column="1" Minimum="300" Maximum="4000"
                            Value="{Binding LatencyMs, Mode=TwoWay}"
                            Style="{StaticResource VolumeSliderStyle}"
                            Height="18" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding LatencyLabel}"
                               Style="{StaticResource SmallStyle}" VerticalAlignment="Center"
                               Margin="8,0,0,0" MinWidth="52" TextAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- ── Volume section ────────────────────────────────── -->
            <StackPanel Margin="16,14,16,4">

                <!-- Volume header row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mute / speaker button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleMuteCommand}"
                            Width="32" Height="32"
                            ToolTip="Toggle mute"
                            Margin="0,0,8,0">
                        <TextBlock FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🔊"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="🔇"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Volume label -->
                    <TextBlock Grid.Column="1"
                               Text="PC volume"
                               Style="{StaticResource BodyStyle}"
                               VerticalAlignment="Center"/>

                    <!-- Volume percentage -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding VolumeLabel}"
                               Style="{StaticResource BodyStyle}"
                               VerticalAlignment="Center"
                               />
                </Grid>

                <!-- Volume slider -->
                <Slider Value="{Binding Volume, Mode=TwoWay}"
                        Height="20">
                    <Slider.Style>
                        <Style TargetType="Slider" BasedOn="{StaticResource VolumeSliderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Slider.Style>
                </Slider>

                <!-- Audio level meter -->
                <Grid Margin="0,10,0,0" Height="6">
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="3"/>
                    <Border HorizontalAlignment="Left"
                            CornerRadius="3"
                            Width="{Binding AudioLevel,
                                   Converter={x:Static local:WidthConverter.Instance},
                                   ConverterParameter=280}"
                            xmlns:local="clr-namespace:CastDriver.UI">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#30D158" Offset="0"/>
                                <GradientStop Color="#30D158" Offset="0.6"/>
                                <GradientStop Color="#FFD60A" Offset="0.8"/>
                                <GradientStop Color="#FF453A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock Text="Live audio level"
                           Style="{StaticResource SmallStyle}"
                           Margin="0,4,0,0"/>

                <!-- Cast-only mode row -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cast Only"
                                   Style="{StaticResource BodyStyle}"/>
                        <TextBlock Margin="0,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SmallStyle}">
                                    <Setter Property="Text" Value="PC speakers play along with the cast"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCastOnlyMode}" Value="True">
                                            <Setter Property="Text" Value="PC speakers silenced — only the cast plays"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsCastOnlyMode, Mode=TwoWay}"
                                  Width="44" Height="24"
                                  VerticalAlignment="Center">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Track"
                                                    Width="44" Height="24"
                                                    CornerRadius="12"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Ellipse x:Name="Thumb"
                                                             Width="18" Height="18"
                                                             Fill="White"
                                                             HorizontalAlignment="Left"
                                                             Margin="2,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Track" Property="Background"
                                                            Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Track" Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Thumb" Property="HorizontalAlignment"
                                                            Value="Right"/>
                                                    <Setter TargetName="Thumb" Property="Margin"
                                                            Value="0,0,2,0"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Grid>

            </StackPanel>

            <Separator Margin="16,8"/>

            <!-- ── Cast to section ──────────────────────────────── -->
            <StackPanel Margin="16,4,16,4">

                <!-- Section header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CAST TO"
                               Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center"/>
                    <!-- Scanning spinner text -->
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource SmallStyle}"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                        <TextBlock.Text>🔍 Scanning…</TextBlock.Text>
                    </TextBlock>
                </Grid>

                <!-- Device list -->
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="10"
                                    Margin="0,0,0,6"
                                    Padding="12,10"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCasting}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource RedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                              <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{StaticResource TextTertiaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCasting}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                        <Setter Property="Fill" Value="#FFFFD60A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource RedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Device name + status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13" FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource BorderBrush}"
                                                    CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,1,0,0"
                                                   FontSize="11"
                                                   Visibility="{Binding HasError,
                                                                Converter={StaticResource BoolVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource RedBrush}"/>
                                                    <Setter Property="Text"
                                                            Value="{Binding ErrorText}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Cast / Stop button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.ToggleDeviceCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5"
                                            FontSize="12"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Content" Value="Cast ▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCasting}" Value="True">
                                                        <Setter Property="Content"    Value="■ Live"/>
                                                        <Setter Property="Background" Value="#33FF453A"/>
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                        <Setter Property="Content"    Value="…"/>
                                                        <Setter Property="IsEnabled"  Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- This device's own volume (Chromecast-side, instant) -->
                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding IsCasting, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding ToggleDeviceMuteCommand}"
                                            Width="26" Height="26" Margin="0,0,6,0"
                                            ToolTip="Mute this device">
                                        <TextBlock FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🔊"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeviceMuted}" Value="True">
                                                            <Setter Property="Text" Value="🔇"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Slider Grid.Column="1"
                                            Value="{Binding Volume, Mode=TwoWay}"
                                            Height="18" VerticalAlignment="Center">
                                        <Slider.Style>
                                            <Style TargetType="Slider" BasedOn="{StaticResource VolumeSliderStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeviceMuted}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBlock Grid.Column="2" Text="{Binding VolumeLabel}"
                                               Style="{StaticResource SmallStyle}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               MinWidth="30" TextAlignment="Right"/>
                                </Grid>
                              </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state / status -->
                <TextBlock Text="{Binding DiscoveryStatus}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SmallStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

            <Separator Margin="16,8"/>

            <!-- ── Footer ────────────────────────────────────────── -->
            <StackPanel Margin="16,4,16,16">

                <!-- Stop All + version -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Stop All"
                                Command="{Binding StopAllCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="12,6" FontSize="12"/>
                        <Button Content="About"
                                Click="OnOpenAbout"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="12,6" FontSize="12" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersion}"
                                   Style="{StaticResource SmallStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                        <Button Content="Exit"
                                Click="OnExit"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="12,6" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
