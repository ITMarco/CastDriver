<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\CastDriver.Audio\CastDriver.Audio.csproj" />
    <ProjectReference Include="..\CastDriver.Cast\CastDriver.Cast.csproj" />
    <ProjectReference Include="..\CastDriver.Driver\CastDriver.Driver.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundle the GPLv3 text next to the exe for the About → View license button. -->
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.10.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed the LAME native DLLs so MP3 works in the single-file build. NAudio.Lame only
         ships them as content (not native runtime libs), so they don't get bundled; we
         extract+load them at startup instead (App.PreloadLame). -->
    <EmbeddedResource Include="lame\libmp3lame.64.dll" />
    <EmbeddedResource Include="lame\libmp3lame.32.dll" />
  </ItemGroup>
</Project>